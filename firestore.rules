rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules → Publish.
// Everyone can READ announcements, news and events.
// Only accounts listed in the `admins` collection can change anything.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      // An account may check whether it is an admin; admins can see the list
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin();
      // Admins can remove other admins, but never themselves (so the site is never locked out)
      allow delete: if isAdmin() && request.auth.uid != uid;
      allow update: if false;
    }

    match /announcements/{id} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.title is map;
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /news/{id} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.title is map;
      allow delete: if isAdmin();
      allow update: if false;
    }

    // "Stay up to date" sign-ups: anyone may sign up (with consent), only admins can see or remove them.
    // The document id must be the lower-case email, so the same email cannot sign up twice.
    match /subscribers/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'consent', 'lang', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s/]+@[^@\\s/]+\\.[^@\\s/]+$')
        && id == request.resource.data.email.lower()
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 30
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /events/{id} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.date is string && request.resource.data.title is map;
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
